{
  "name": "diagramkit",
  "version": "0.1.0",
  "description": "A hierarchical spatial board tool for creating mind maps and workflows.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "diagramkit": "bin/diagramkit"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite --host\" \"tsx watch --exclude ./data --exclude ./dist server/index.ts\"",
    "dev:web": "vite --host",
    "dev:server": "tsx watch --exclude ./data --exclude ./dist server/index.ts",
    "build": "tsc && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "diagramkit": "tsx cli/index.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "@xyflow/react": "^12.10.0",
    "hono": "^4.9.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.4.49",
    "postcss-import": "^16.1.0",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.4.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
